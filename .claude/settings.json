{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(php -v)",
      "Bash(f:/xamppPro80/php/php.exe -v)",
      "Bash(composer:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(php artisan:*)",
      "mcp__context7__resolve-library-id",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:packagist.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(rm -rf node_modules package-lock.json)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(rm public/css/app.css)",
      "Bash(rm -rf public/js/datatables)",
      "WebFetch(domain:siigonube.siigo.com)",
      "WebFetch(domain:developers.siigo.com)",
      "WebFetch(domain:siigoapi.docs.apiary.io)",
      "WebFetch(domain:saprodcentralassets.blob.core.windows.net)",
      "WebFetch(domain:www.tiny.cloud)",
      "WebFetch(domain:www.dlpsystems.co)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./vendor/bin/pint --quiet 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./vendor/bin/phpstan analyse --memory-limit=2G --no-progress --error-format=raw 2>&1 | tail -30"
          }
        ]
      }
    ]
  }
}
